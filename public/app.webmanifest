{
  "id": "/app",
  "name": "TeacherAid",
  "short_name": "TeacherAid",
  "description": "Скенирај го кодот на часот, пријави се и играј го квизот во живо.",
  "lang": "mk",
  "start_url": "/app",
  "scope": "/app",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#1a5dae",
  "theme_color": "#1a5dae",
  "icons": [
    {
      "src": "/app-icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/app-icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/app-icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "categories": [
    "education"
  ],
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "shortcuts": [
    {
      "name": "Скенирај го кодот на часот",
      "short_name": "Скенирај",
      "url": "/app/scan",
      "icons": [
        {
          "src": "/app-icons/shortcut-scan.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "/app-screens/home.webp",
      "sizes": "1170x2532",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "Почетна: следниот час, присуството и рангот"
    },
    {
      "src": "/app-screens/quiz.webp",
      "sizes": "1170x2532",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "Квиз во живо на часот"
    },
    {
      "src": "/app-screens/attendance.webp",
      "sizes": "1170x2532",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "Присуство по часови"
    }
  ]
}
